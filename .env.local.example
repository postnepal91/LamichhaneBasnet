# Copy this file to .env.local for local development
# Add these SAME variables in: Vercel Dashboard → Your Project → Settings → Environment Variables

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lamichhaneb?retryWrites=true&w=majority

# Database name
MONGODB_DB=lamichhaneb

# JWT Secret — use any long random string (e.g. generate at: https://randomkeygen.com/)
JWT_SECRET=replace_with_long_random_secret_here

# Google OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
